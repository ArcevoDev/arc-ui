{
  "name": "@arc-ui/tokens",
  "version": "0.1.0",
  "description": "Design tokens for the ArcevoCirqle ecosystem — Alpha Palette colors, typography, spacing, and sub-brand accents in OKLCH",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node -e \"require('fs').cpSync('src/tokens.css', 'dist/tokens.css')\"",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcevoDev/arc-ui.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/ArcevoDev/arc-ui/issues"
  },
  "homepage": "https://arc-ui.vercel.app",
  "license": "MIT",
  "keywords": ["design-tokens", "alpha-palette", "arcevocirqle", "ui", "oklch"],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
